<style>
:root{
  --paper:#f7f1e4;--card:#fffdf8;--ink:#2a1f1a;--muted:#6e5d52;--line:#e2d6c2;
  --acc:#6b2d5c;--acc-ink:#ffffff;--gold:#e08a1e;--hl:#fde68a;--hl-ink:#2a1f1a;
  --ok:#2f7a4a;--ok-bg:#e2f2e6;--bad:#b23a2a;--bad-bg:#fbe4de;--chip:#f1e8d8;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#1a1512;--card:#241d18;--ink:#f1e8dc;--muted:#b6a593;--line:#3a3028;
    --acc:#d48bc4;--acc-ink:#1a1512;--gold:#f0a540;--hl:#7a6420;--hl-ink:#fff6d6;
    --ok:#74d39a;--ok-bg:#183424;--bad:#ff907a;--bad-bg:#3d1f18;--chip:#2e261f;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#1a1512;--card:#241d18;--ink:#f1e8dc;--muted:#b6a593;--line:#3a3028;
  --acc:#d48bc4;--acc-ink:#1a1512;--gold:#f0a540;--hl:#7a6420;--hl-ink:#fff6d6;
  --ok:#74d39a;--ok-bg:#183424;--bad:#ff907a;--bad-bg:#3d1f18;--chip:#2e261f;
  color-scheme:dark;
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.55 "Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--paper)}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--paper);border-bottom:3px solid var(--acc)}
.top{max-width:720px;margin:auto;padding:14px 16px 2px;display:flex;align-items:baseline;gap:10px}
h1{font-family:Fraunces,Georgia,serif;font-weight:700;font-size:1.5rem;margin:0;color:var(--acc)}
.top small{color:var(--muted)}
.tabs{display:flex;gap:6px;overflow-x:auto;padding:10px 16px 12px;max-width:720px;margin:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{flex:0 0 auto;font:700 .9rem "Atkinson Hyperlegible",system-ui,sans-serif;border:2px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:6px 13px;cursor:pointer}
.tab.on{background:var(--acc);color:var(--acc-ink);border-color:var(--acc)}
main{max-width:720px;margin:auto;padding:16px 14px 48px}
.intro{color:var(--muted);margin:0 0 14px}
.card{background:var(--card);border:2px solid var(--line);border-radius:16px;padding:16px;margin:0 0 14px;position:relative}
.qn{display:inline-block;font:700 .78rem "Atkinson Hyperlegible",system-ui,sans-serif;color:var(--acc-ink);background:var(--gold);border-radius:6px;padding:1px 8px;letter-spacing:.02em}
.q{font-weight:700;margin:8px 0 12px;white-space:pre-line}
.opts{display:grid;gap:8px}
button{font:inherit;cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.opt{text-align:left;padding:11px 13px;border-radius:12px;border:2px solid var(--line);background:var(--paper);color:var(--ink)}
.opt:disabled{cursor:default}
.ok{background:var(--ok-bg)!important;border-color:var(--ok)!important}
.bad{background:var(--bad-bg)!important;border-color:var(--bad)!important}
.btn{padding:10px 16px;border-radius:12px;border:none;background:var(--acc);color:var(--acc-ink);font-weight:700}
.btn.soft{background:var(--chip);color:var(--ink)}
.btn:disabled{opacity:.4;cursor:default}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.fb:empty{display:none}
.fb{margin-top:12px;padding:10px 12px;border-radius:10px;font-size:.95rem}
.fb.okm{background:var(--ok-bg);color:var(--ok)}
.fb.badm{background:var(--bad-bg);color:var(--bad)}
.fill{line-height:2.5}
.fill input{font:inherit;width:7.5em;padding:2px 8px;border:none;border-bottom:3px solid var(--ink);border-radius:4px;background:var(--hl);color:var(--hl-ink)}
.fix{color:var(--ok);font-weight:700;font-size:.9rem;margin:0 4px;white-space:nowrap}
.bank{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0 0;padding-top:10px;border-top:2px dashed var(--line)}
.chip{padding:5px 11px;border-radius:999px;background:var(--chip);border:1px solid var(--line);color:var(--ink);font-size:.92rem}
.mrow{display:grid;gap:6px;padding:10px 0;border-bottom:1px dashed var(--line)}
.mrow:last-of-type{border-bottom:none}
.mrow b{color:var(--acc)}
select{font:inherit;width:100%;padding:8px;border-radius:10px;border:2px solid var(--line);background:var(--paper);color:var(--ink)}
textarea{width:100%;box-sizing:border-box;min-height:100px;font:inherit;padding:10px;border-radius:12px;border:2px solid var(--line);background:var(--paper);color:var(--ink)}
.model{margin-top:12px;padding:12px;border-left:5px solid var(--gold);background:var(--chip);border-radius:8px}
.seq{display:flex;flex-direction:column;gap:6px;margin:4px 0 12px}
.seq div{padding:8px 11px;border-radius:10px;background:var(--chip)}
.hint{color:var(--muted);font-size:.92rem}
.scorebar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;background:var(--card);border:2px solid var(--line);border-radius:16px;padding:10px 14px;margin:0 0 14px}
.scorebar .row{margin:0}
.flash{min-height:210px;display:grid;place-items:center;text-align:center;font:700 1.6rem Fraunces,Georgia,serif;cursor:pointer;user-select:none}
.flash small{display:block;font:400 1rem "Atkinson Hyperlegible",system-ui,sans-serif;color:var(--muted);margin-top:10px}
@media (prefers-reduced-motion:no-preference){.fb{animation:pop .25s ease-out}@keyframes pop{from{transform:scale(.97);opacity:0}to{transform:none;opacity:1}}}
</style>
</head>
