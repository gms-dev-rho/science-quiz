const TYPE={mc:'Crocetta',tf:'Vero o falso',fill:'Completa',match:'Abbina',order:'Metti in ordine',open:'Domanda aperta'};

function renderItem(it,n,record){
  const c=el('div','card');
  c.append(el('span','qn',`${n} · ${TYPE[it.t]}`));
  const fb=el('div','fb');
  const q=t=>c.append(el('div','q',t));
  const done=(ok,msg)=>{fb.className='fb '+(ok?'okm':'badm');fb.innerHTML=(ok?'✅ ':'❌ ')+(msg||(ok?pick(PRAISE):'Non proprio.'));record(ok)};

  if(it.t==='mc'||it.t==='tf'){
    const opts=it.t==='tf'?['Vero','Falso']:shuffle(it.opts);
    const ans=it.t==='tf'?(it.a?'Vero':'Falso'):it.opts[it.a];
    q(it.q);const box=el('div','opts');
    opts.forEach(o=>{const b=el('button','opt');b.textContent=o;b.onclick=()=>{
      [...box.children].forEach(x=>{x.disabled=true;if(x.textContent===ans)x.classList.add('ok')});
      const ok=o===ans;if(!ok)b.classList.add('bad');
      done(ok,(ok?pick(PRAISE)+' ':'La risposta giusta è: <b>'+ans+'</b>. ')+(it.ex||''));
    };box.append(b)});
    c.append(box);
  }

  if(it.t==='fill'){
    q('Completa la frase.');
    const p=el('div','fill');const ins=[];let last=null;
    const parts=it.q.split('___');
    parts.forEach((t,i)=>{p.append(document.createTextNode(t));if(i<parts.length-1){const x=document.createElement('input');x.setAttribute('autocapitalize','off');x.autocomplete='off';x.spellcheck=false;x.onfocus=()=>{last=x};ins.push(x);p.append(x)}});
    c.append(p);
    if(it.bank){const bk=el('div','bank');shuffle(it.bank).forEach(w=>{const ch=el('button','chip');ch.textContent=w;ch.onclick=()=>{
      const t=(last&&!last.value&&!last.disabled)?last:ins.find(x=>!x.value&&!x.disabled);
      if(t){t.value=w;last=ins.find(x=>!x.value)||null}
    };bk.append(ch)});c.append(bk)}
    const chk=el('button','btn','Controlla');
    chk.onclick=()=>{
      let all=true;
      ins.forEach((x,i)=>{
        const v=norm(x.value);const ok=v&&it.a[i].some(s=>norm(s)===v);
        x.disabled=true;x.classList.add(ok?'ok':'bad');
        if(!ok){all=false;x.insertAdjacentHTML('afterend',`<span class="fix">→ ${it.a[i][0]}</span>`)}
      });
      chk.remove();done(all,all?pick(PRAISE)+(it.ex?' '+it.ex:''):'Guarda le parole in verde. '+(it.ex||''));
    };
    c.append(row(chk));
  }

  if(it.t==='match'){
    q(it.q);
    const rights=shuffle([...new Set(it.pairs.map(p=>p[1]))]);
    const sels=shuffle(it.pairs).map(([l,r])=>{
      const w=el('div','mrow');w.append(el('b',null,l));
      const s=document.createElement('select');s.setAttribute('aria-label',l);
      s.innerHTML='<option value="">scegli…</option>'+rights.map(o=>`<option>${o}</option>`).join('');
      w.append(s);c.append(w);return {s,r,w}});
    const chk=el('button','btn','Controlla');
    chk.onclick=()=>{let all=true;sels.forEach(({s,r,w})=>{const ok=s.value===r;s.disabled=true;s.classList.add(ok?'ok':'bad');if(!ok){all=false;w.append(el('span','fix','→ '+r))}});chk.remove();done(all,all?pick(PRAISE):'Guarda le risposte in verde.')};
    c.append(row(chk));
  }

  if(it.t==='order'){
    q(it.q);const seq=el('div','seq'),pool=el('div','opts'),picked=[];
    const draw=()=>{seq.innerHTML=picked.length?picked.map((s,i)=>`<div><b>${i+1}.</b> ${s}</div>`).join(''):'<span class="hint">Tocca gli eventi qui sotto nell’ordine giusto.</span>'};
    shuffle(it.a).forEach(s=>{const b=el('button','opt');b.textContent=s;b.onclick=()=>{picked.push(s);b.style.display='none';draw()};pool.append(b)});
    const undo=el('button','btn soft','↶ Annulla');undo.onclick=()=>{const s=picked.pop();if(s){[...pool.children].find(b=>b.textContent===s).style.display='';draw()}};
    const chk=el('button','btn','Controlla');
    chk.onclick=()=>{
      if(picked.length<it.a.length){fb.className='fb badm';fb.textContent='Prima metti in ordine tutti gli eventi.';return}
      const ok=picked.every((s,i)=>s===it.a[i]);
      seq.innerHTML=picked.map((s,i)=>`<div class="${s===it.a[i]?'ok':'bad'}"><b>${i+1}.</b> ${s}</div>`).join('');
      undo.remove();chk.remove();
      done(ok,(ok?pick(PRAISE)+' ':'L’ordine giusto è:<br>'+it.a.map((s,i)=>`${i+1}. ${s}`).join('<br>')+'<br>')+(it.ex||''));
    };
    draw();c.append(seq,pool,row(undo,chk));
  }

  if(it.t==='open'){
    q(it.q);const ta=document.createElement('textarea');ta.placeholder='Scrivi qui la tua risposta…';c.append(ta);
    const show=el('button','btn','Mostra la risposta modello');c.append(row(show));
    show.onclick=()=>{
      show.parentNode.remove();
      c.insertBefore(el('div','model','<b>Risposta modello</b><br>'+it.model+(it.keys?'<br><br><b>Parole chiave:</b> '+it.keys.join('; '):'')),fb);
      const y=el('button','btn','✓ Avevo i concetti chiave'),nn=el('button','btn soft','✗ Non ancora');const r2=row(y,nn);c.insertBefore(r2,fb);
      y.onclick=()=>{r2.remove();done(true,'Ottimo lavoro!')};
      nn.onclick=()=>{r2.remove();done(false,'Rileggi la risposta modello e prova a ripeterla a voce alta.')};
    };
  }
  c.append(fb);return c;
}

function practice(m,intro,items,restart){
  m.innerHTML='';m.append(el('p','intro',intro));
  const res={};const bars=[];
  const mkBar=()=>{
    const b=el('div','scorebar',`<div class="sc"></div><div class="row"><button class="btn soft rs">↻ Ricomincia</button><button class="btn rt">Rifai gli errori</button></div>`);
    const upd=()=>{
      const v=Object.values(res),ok=v.filter(Boolean).length,wrong=v.length-ok,left=items.length-v.length;
      b.querySelector('.sc').innerHTML=`✅ <b>${ok}</b> &nbsp; ❌ <b>${wrong}</b> &nbsp; ${left?'mancano '+left:(wrong?'Finito!':'Tutto giusto! 🎉')}`;
      b.querySelector('.rt').disabled=!wrong;
    };
    b.querySelector('.rs').onclick=()=>{restart();scrollTo(0,0)};
    b.querySelector('.rt').onclick=()=>{const w=items.filter(it=>res[it.uid]===false);practice(m,'Riproviamo le domande sbagliate 💪',w,restart);scrollTo(0,0)};
    bars.push(upd);upd();return b;
  };
  m.append(mkBar());
  items.forEach((it,i)=>m.append(renderItem(it,i+1,ok=>{res[it.uid]=ok;bars.forEach(f=>f())})));
  m.append(mkBar());
}

