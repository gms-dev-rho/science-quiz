  let rev=false,deck=shuffle(CARDS),known=0,flipped=false;
  m.innerHTML=`<p class="intro">Date e parole chiave. Prova a ricordare, poi tocca la carta per girarla.</p>
  <div class="row" style="margin:0 0 12px"><button class="btn soft" id="dir"></button><button class="btn soft" id="fr">↻ Mescola</button></div>
  <div class="card flash" id="fc" role="button" tabindex="0"></div>
  <div class="row"><button class="btn soft" id="ag">↻ La rivedo dopo</button><button class="btn" id="kn">✓ La so</button></div>
  <p class="intro" id="fcount" style="margin-top:12px"></p>`;
  const draw=()=>{
    $('#dir').textContent=rev?'Davanti: spiegazione':'Davanti: data o parola';
    if(!deck.length){$('#fc').innerHTML='<div>🎉 Finite!<small>Tocca “Mescola” per ricominciare</small></div>';$('#fcount').textContent='';return}
    const w=deck[0],front=rev?w.b:w.f,back=rev?w.f:w.b;
    $('#fc').innerHTML=flipped?`<div>${back}</div>`:`<div>${front}<small>tocca per girare</small></div>`;
    $('#fcount').textContent=`Carte rimaste: ${deck.length} · già sapute: ${known}`;
  };
  const flip=()=>{flipped=!flipped;draw()};
  $('#fc').onclick=flip;$('#fc').onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();flip()}};
  $('#kn').onclick=()=>{if(!deck.length)return;deck.shift();known++;flipped=false;draw()};
  $('#ag').onclick=()=>{if(!deck.length)return;deck.push(deck.shift());flipped=false;draw()};
  $('#dir').onclick=()=>{rev=!rev;flipped=false;draw()};
  $('#fr').onclick=()=>{deck=shuffle(CARDS);known=0;flipped=false;draw()};
  draw();
}

function renderMix(m){
  const all=SECTIONS.flatMap(s=>s.items.map((it,i)=>({...it,uid:s.id+i}))).filter(it=>it.t!=='open');
  practice(m,'Simulazione di verifica: 15 domande a caso da tutti i capitoli. 🎯',shuffle(all).slice(0,15),()=>renderMix(m));
}

const TABS=[...SECTIONS.map(s=>({id:s.id,label:s.tab})),{id:'mix',label:'🎯 Verifica'},{id:'flash',label:'🃏 Carte'}];
function go(id){
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.id===id));
  const m=$('#main');
  if(id==='flash')return renderFlash(m);
  if(id==='mix')return renderMix(m);
  const s=SECTIONS.find(x=>x.id===id);
  practice(m,s.intro,s.items.map((it,i)=>({...it,uid:id+i})),()=>go(id));
}
TABS.forEach(t=>{const b=el('button','tab');b.textContent=t.label;b.dataset.id=t.id;b.onclick=()=>{go(t.id);scrollTo(0,0)};$('#tabs').append(b)});
go('cad');
</script>
</body>
